{
  "name": "verhage-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Agentic chat interface for the Verhage Hoofddorp webshop \u2014 builds a cart through conversation, never checks out.",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "AGENT_PROVIDER=fallback node --test tests/*.test.js",
    "catalog": "node scripts/build-catalog.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "express": "^4.21.2",
    "openai": "^7.8.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=20.6"
  }
}
