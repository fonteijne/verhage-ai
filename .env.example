# ---------------------------------------------------------------------------
# Agent provider. All three drive the identical tool set, so the cart
# behaviour, the cross-selling and the no-checkout guarantee are the same
# whichever is active — only the language understanding differs.
#
# With nothing set below, the app runs a deterministic rule-based agent and
# needs no credentials at all.
# ---------------------------------------------------------------------------

# Option 1 — Anthropic directly.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=low

# Option 2 — OpenRouter (~400 models behind one OpenAI-compatible endpoint).
OPENROUTER_API_KEY=
# Any tool-calling model, e.g. anthropic/claude-opus-5, openai/gpt-5.2,
# google/gemini-2.5-pro, meta-llama/llama-3.3-70b-instruct
# OPENROUTER_MODEL=anthropic/claude-opus-5
# Attribution shown on OpenRouter's app leaderboards.
# OPENROUTER_SITE_URL=https://github.com/fonteijne/verhage-ai
# OPENROUTER_APP_NAME=Verhage AI
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Force one provider. Without this, the first configured one wins
# (Anthropic before OpenRouter); "fallback" forces the rule-based agent.
# AGENT_PROVIDER=openrouter

# PORT=3001
